{
  "name": "kinlang",
  "scopeName": "source.kin",
  "uuid": "2e12aebc-e05d-46b8-bece-9fe4cbf0fe3a",
  "patterns": [
    {
      "match": "#.*$",
      "name": "comment.line.number-sign.kin"
    },
    {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.kin"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kin"
        }
      },
      "name": "string.quoted.double.kin"
    },
    {
      "match": "\\b(porogaramu_ntoya)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.kin"
        },
        "2": {
          "name": "entity.name.function.kin"
        }
      }
    },
    {
      "match": "\\b(reka|ntahinduka)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(number|string|boolean|object|urutonde|fn|native-fn)(\\?)?",
      "captures": {
        "1": {
          "name": "keyword.control.kin"
        },
        "2": {
          "name": "variable.other.kin"
        },
        "3": {
          "name": "punctuation.separator.type.kin"
        },
        "4": {
          "name": "support.type.kin"
        },
        "5": {
          "name": "punctuation.definition.optional-type.kin"
        }
      }
    },
    {
      "match": "\\b(reka|ntahinduka|porogaramu_ntoya|tanga|subiramo_niba|hagarara|komeza|niba|nanone_niba|niba_byanze|gereranya|usanze|ibindi)\\b",
      "name": "keyword.control.kin"
    },
    {
      "match": "(?<!\\.)\\b(nibyo|sibyo)\\b",
      "name": "constant.language.boolean.kin"
    },
    {
      "match": "(?<!\\.)\\bubusa\\b",
      "name": "constant.language.null.kin"
    },
    {
      "match": "(?<!\\.)\\bikosa\\b",
      "name": "constant.language.error.kin"
    },
    {
      "match": "\\b(KIN_AMAGAMBO|KIN_URUTONDE|KIN_INYANDIKO|KIN_IGIHE|KIN_IMIBARE)\\b",
      "name": "support.class.kin"
    },
    {
      "match": "(?<!\\.)\\bfilename\\b",
      "name": "constant.language.kin"
    },
    {
      "match": "\\b(tangaza_amakuru|injiza_amakuru|sisitemu|ubwoko)\\b",
      "name": "support.function.kin"
    },
    {
      "match": "\\.\\s*(pi|umuzikare|umubare_utazwi|kuraho_ibice|sin|cos|tan|huza|ingano|inyuguti_nkuru|inyuguti_ntoya|inyuguti|tandukanya|ongera_kumusozo|siba_kumusozo|ifite_ikirango|ifite|kora_ijambo|injiza_ahabanza|siba_ahabanza|isaha|umunsi|itariki|soma|andika|vugurura|siba)\\b",
      "name": "support.function.member.kin"
    },
    {
      "match": "\\b-?(?:0|[1-9]\\d*)(?:\\.\\d+)?\\b",
      "name": "constant.numeric.kin"
    },
    {
      "match": "==|!=|>=|<=|>|<",
      "name": "keyword.operator.comparison.kin"
    },
    {
      "match": "&&|\\|\\|",
      "name": "keyword.operator.logical.kin"
    },
    {
      "match": "(?<![A-Za-z0-9_])!(?!=)",
      "name": "keyword.operator.logical.kin"
    },
    {
      "match": "\\+|-|\\*|/|%|\\^",
      "name": "keyword.operator.arithmetic.kin"
    },
    {
      "match": "=",
      "name": "keyword.operator.assignment.kin"
    },
    {
      "match": "\\.",
      "name": "punctuation.accessor.kin"
    },
    {
      "match": "\\[|\\]|\\(|\\)",
      "name": "punctuation.delimiter.kin"
    },
    {
      "match": "\\{|\\}",
      "name": "punctuation.definition.block.kin"
    },
    {
      "match": ";",
      "name": "punctuation.terminator.kin"
    },
    {
      "match": ",",
      "name": "punctuation.separator.kin"
    },
    {
      "match": ":",
      "name": "punctuation.separator.key-value.kin"
    },
    {
      "match": "\\?",
      "name": "punctuation.definition.optional-type.kin"
    }
  ]
}
